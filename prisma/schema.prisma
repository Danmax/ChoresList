generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x", "linux-musl-openssl-3.0.x", "linux-musl"]
}

datasource db {
  provider  = "mysql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model ParentAccount {
  id            Int      @id @default(autoincrement())
  householdId   Int
  email         String   @unique @db.VarChar(255)
  passwordHash  String   @db.VarChar(255)
  passwordSalt  String   @db.VarChar(255)
  pinHash       String?  @db.VarChar(255)
  pinSalt       String?  @db.VarChar(255)
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  household          Household                @relation(fields: [householdId], references: [id], onDelete: Cascade)
  confirmationTokens EmailConfirmationToken[]
  passwordResetTokens PasswordResetToken[]
}

model Household {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(255)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  parents           ParentAccount[]
  members           FamilyMember[]
  chores            Chore[]
  assignments       ChoreAssignment[]
  completions       TaskCompletion[]
  skillCategories   SkillCategory[]
  allowances        WeeklyAllowance[]
  allowanceSettings AllowanceSettings[]
  wishList          WishListItem[]
  houseProjects     HouseProject[]
  rewardTickets     RewardTicket[]
  events            FamilyEvent[]
  devices           HouseholdDevice[]
  pairingCodes      DevicePairingCode[]
}

model EmailConfirmationToken {
  id        Int       @id @default(autoincrement())
  parentId  Int
  tokenHash String    @unique @db.VarChar(255)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  parent ParentAccount @relation(fields: [parentId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  parentId  Int
  tokenHash String    @unique @db.VarChar(255)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  parent ParentAccount @relation(fields: [parentId], references: [id], onDelete: Cascade)
}

model FamilyMember {
  id          Int      @id @default(autoincrement())
  householdId Int
  name        String   @db.VarChar(255)
  age         Int
  role        String   @default("child") @db.VarChar(64)
  avatar      String   @default("🧒") @db.VarChar(32)
  color       String   @default("#a78bfa") @db.VarChar(32)
  totalPoints Int      @default(0)
  level       Int      @default(1)
  createdAt   DateTime @default(now())

  assignments      ChoreAssignment[]
  completions      TaskCompletion[]
  allowances       WeeklyAllowance[]
  skills           MemberSkill[]
  allowanceSetting AllowanceSettings?
  wishList         WishListItem[]
  houseProjects    HouseProject[]     @relation("ProjectAssignee")
  rewardTickets    RewardTicket[]
  devices          HouseholdDevice[]
  pairingCodes     DevicePairingCode[]
  household        Household          @relation(fields: [householdId], references: [id], onDelete: Cascade)
}

model Chore {
  id            Int     @id @default(autoincrement())
  householdId   Int
  name          String  @db.VarChar(255)
  description   String? @db.Text
  icon          String  @default("✅") @db.VarChar(32)
  color         String  @default("#e0e7ff") @db.VarChar(32)
  ageMin        Int     @default(3)
  ageMax        Int     @default(18)
  pointsValue   Int     @default(10)
  category      String  @default("other") @db.VarChar(64)
  requiresPhoto Boolean @default(false)

  assignments  ChoreAssignment[]
  skillLinks   ChoreSkill[]
  instructions ChoreInstructions?
  household    Household          @relation(fields: [householdId], references: [id], onDelete: Cascade)
}

model ChoreAssignment {
  id          Int       @id @default(autoincrement())
  householdId Int
  memberId    Int
  choreId     Int
  frequency   String    @default("daily") @db.VarChar(64)
  dueDate     DateTime?
  dayOfWeek   Int?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  member      FamilyMember     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  chore       Chore            @relation(fields: [choreId], references: [id], onDelete: Cascade)
  completions TaskCompletion[]
  household   Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
}

model TaskCompletion {
  id               Int      @id @default(autoincrement())
  householdId      Int
  assignmentId     Int
  memberId         Int
  completedAt      DateTime @default(now())
  photoBeforePath  String?
  photoAfterPath   String?
  pointsEarned     Int      @default(0)
  verifiedByParent Boolean  @default(false)
  weekStartDate    DateTime @default(now())

  assignment ChoreAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  member     FamilyMember    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  household  Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)
}

model SkillCategory {
  id          Int    @id @default(autoincrement())
  householdId Int
  name        String @db.VarChar(255)
  icon        String @default("⭐") @db.VarChar(32)

  chores    ChoreSkill[]
  members   MemberSkill[]
  household Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
}

model ChoreSkill {
  choreId Int
  skillId Int

  chore Chore         @relation(fields: [choreId], references: [id], onDelete: Cascade)
  skill SkillCategory @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([choreId, skillId])
}

model MemberSkill {
  memberId Int
  skillId  Int
  xp       Int @default(0)
  level    Int @default(1)

  member FamilyMember  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  skill  SkillCategory @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([memberId, skillId])
}

model WeeklyAllowance {
  id           Int      @id @default(autoincrement())
  householdId  Int
  memberId     Int
  weekStart    DateTime
  pointsEarned Int      @default(0)
  amountEarned Float    @default(0)
  paidOut      Boolean  @default(false)

  member    FamilyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  household Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([memberId, weekStart])
}

model AllowanceSettings {
  id             Int   @id @default(autoincrement())
  householdId    Int
  memberId       Int   @unique
  weeklyBaseRate Float @default(0)
  pointsToDollar Float @default(0.10)

  member    FamilyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  household Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)
}

model ChoreInstructions {
  id          Int      @id @default(autoincrement())
  choreId     Int      @unique
  steps       String   @db.Text
  tips        String   @db.Text
  safetyNotes String   @db.Text
  aiGenerated Boolean  @default(true)
  updatedAt   DateTime @default(now()) @updatedAt

  chore Chore @relation(fields: [choreId], references: [id], onDelete: Cascade)
}

model WishListItem {
  id          Int      @id @default(autoincrement())
  householdId Int
  memberId    Int
  title       String   @db.VarChar(255)
  category    String   @default("other") @db.VarChar(64)
  emoji       String   @default("🎁") @db.VarChar(32)
  note        String?  @db.Text
  status      String   @default("pending") @db.VarChar(64)
  createdAt   DateTime @default(now())

  member    FamilyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  household Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)
}

model HouseProject {
  id          Int       @id @default(autoincrement())
  householdId Int
  title       String    @db.VarChar(255)
  description String?   @db.Text
  category    String    @default("other") @db.VarChar(64)
  emoji       String    @default("🔧") @db.VarChar(32)
  rewardTitle String    @db.VarChar(255)
  rewardEmoji String    @default("🎫") @db.VarChar(32)
  pointsBonus Int       @default(50)
  assignedTo  Int?
  status      String    @default("open") @db.VarChar(64)
  dueDate     DateTime?
  createdAt   DateTime  @default(now())

  assignee  FamilyMember?  @relation("ProjectAssignee", fields: [assignedTo], references: [id], onDelete: SetNull)
  tickets   RewardTicket[]
  household Household      @relation(fields: [householdId], references: [id], onDelete: Cascade)
}

model RewardTicket {
  id          Int       @id @default(autoincrement())
  householdId Int
  projectId   Int
  memberId    Int
  rewardTitle String    @db.VarChar(255)
  rewardEmoji String    @default("🎫") @db.VarChar(32)
  status      String    @default("pending") @db.VarChar(64)
  earnedAt    DateTime  @default(now())
  redeemedAt  DateTime?

  project   HouseProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  member    FamilyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  household Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)
}

model FamilyEvent {
  id          Int       @id @default(autoincrement())
  householdId Int
  title       String    @db.VarChar(255)
  eventType   String    @default("other") @db.VarChar(64)
  date        DateTime
  endDate     DateTime?
  allDay      Boolean   @default(true)
  recurring   String    @default("none") @db.VarChar(64)
  notes       String?   @db.Text
  color       String    @default("#fbbf24") @db.VarChar(32)
  icon        String    @default("📅") @db.VarChar(32)
  createdAt   DateTime  @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
}

model HouseholdDevice {
  id          Int       @id @default(autoincrement())
  householdId Int
  memberId    Int?
  name        String    @db.VarChar(255)
  mode        String    @default("household") @db.VarChar(32)
  tokenHash   String    @unique @db.VarChar(255)
  lastSeenAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  household Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  member    FamilyMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)
}

model DevicePairingCode {
  id          Int       @id @default(autoincrement())
  householdId Int
  memberId    Int?
  codeHash    String    @unique @db.VarChar(255)
  deviceName  String    @db.VarChar(255)
  mode        String    @default("household") @db.VarChar(32)
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  household Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  member    FamilyMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)
}
