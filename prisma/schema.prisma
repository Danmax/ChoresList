generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x", "linux-musl-openssl-3.0.x", "linux-musl"]
}

datasource db {
  provider  = "mysql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model ParentAccount {
  id            Int      @id @default(autoincrement())
  householdId   Int
  email         String   @unique @db.VarChar(255)
  passwordHash  String   @db.VarChar(255)
  passwordSalt  String   @db.VarChar(255)
  pinHash       String?  @db.VarChar(255)
  pinSalt       String?  @db.VarChar(255)
  accountRole   String   @default("owner") @db.VarChar(32)
  displayName   String?  @db.VarChar(255)
  parentType    String   @default("parent") @db.VarChar(64)
  relationshipLabel String? @db.VarChar(128)
  childAccessMode String @default("all") @db.VarChar(32)
  childAccessMemberIds Json?
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  household              Household                @relation(fields: [householdId], references: [id], onDelete: Cascade)
  confirmationTokens     EmailConfirmationToken[]
  passwordResetTokens    PasswordResetToken[]
  pinResetTokens         PinResetToken[]
  createdCommunities     CommunityGroup[]         @relation("CommunityCreator")
  communityMemberships   CommunityMember[]
  createdCommunityEvents CommunityEvent[]         @relation("CommunityEventCreator")
  communityRsvps         CommunityRsvp[]
  assignedCommunityItems CommunityEventItem[]     @relation("CommunityItemAssignee")
  claimedCommunityItems  CommunityEventItem[]     @relation("CommunityItemClaimer")
  activatedPlugins       HouseholdPlugin[]        @relation("PluginActivator")
  familyTreeNodes        FamilyTreeNode[]
}

model Household {
  id                            Int      @id @default(autoincrement())
  name                          String   @db.VarChar(255)
  timeZone                      String   @default("America/New_York") @db.VarChar(64)
  googleCalendarEnabled         Boolean  @default(false)
  googleCalendarId              String?  @db.VarChar(255)
  googleCalendarSyncAssignments Boolean  @default(false)
  googleCalendarSyncEvents      Boolean  @default(true)
  emailNotificationsEnabled     Boolean  @default(true)
  emailDailySummary             Boolean  @default(false)
  emailWeeklyReport             Boolean  @default(true)
  privacyShowKidPoints          Boolean  @default(true)
  privacyAllowKidWishlist       Boolean  @default(true)
  privacyStoreCompletionPhotos  Boolean  @default(true)
  privacyAnalyticsOptIn         Boolean  @default(false)
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @default(now()) @updatedAt

  parents                  ParentAccount[]
  members                  FamilyMember[]
  chores                   Chore[]
  assignments              ChoreAssignment[]
  completions              TaskCompletion[]
  skillCategories          SkillCategory[]
  allowances               WeeklyAllowance[]
  allowanceSettings        AllowanceSettings[]
  wishList                 WishListItem[]
  houseProjects            HouseProject[]
  rewardTickets            RewardTicket[]
  events                   FamilyEvent[]
  devices                  HouseholdDevice[]
  pairingCodes             DevicePairingCode[]
  groceryLists             GroceryList[]
  groceryTemplates         GroceryTemplate[]
  googleCalendarConnection GoogleCalendarConnection?
  plugins                  HouseholdPlugin[]
  familyTreeNodes          FamilyTreeNode[]
  familyTreeRelationships  FamilyTreeRelationship[]
}

model HouseholdPlugin {
  id                  Int       @id @default(autoincrement())
  householdId          Int
  pluginKey            String    @db.VarChar(64)
  status               String    @default("inactive") @db.VarChar(32)
  settings             Json?
  activatedAt          DateTime?
  activatedByParentId  Int?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @default(now()) @updatedAt

  household         Household      @relation(fields: [householdId], references: [id], onDelete: Cascade)
  activatedByParent ParentAccount? @relation("PluginActivator", fields: [activatedByParentId], references: [id], onDelete: SetNull)

  @@unique([householdId, pluginKey])
  @@index([pluginKey])
}

model GoogleCalendarConnection {
  id                 String    @id @default(cuid())
  householdId        Int       @unique
  googleAccountEmail String?   @db.VarChar(255)
  calendarId         String    @default("primary") @db.VarChar(255)
  refreshToken       String    @db.Text
  accessToken        String?   @db.Text
  expiresAt          DateTime?
  syncStatus         String?   @db.VarChar(64)
  lastSyncAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @default(now()) @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
}

model EmailConfirmationToken {
  id        Int       @id @default(autoincrement())
  parentId  Int
  tokenHash String    @unique @db.VarChar(255)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  parent ParentAccount @relation(fields: [parentId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  parentId  Int
  tokenHash String    @unique @db.VarChar(255)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  parent ParentAccount @relation(fields: [parentId], references: [id], onDelete: Cascade)
}

model PinResetToken {
  id        Int       @id @default(autoincrement())
  parentId  Int
  tokenHash String    @unique @db.VarChar(255)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  parent ParentAccount @relation(fields: [parentId], references: [id], onDelete: Cascade)
}

model FamilyMember {
  id                        Int      @id @default(autoincrement())
  householdId               Int
  name                      String   @db.VarChar(255)
  age                       Int
  birthdayMonth             Int?
  birthdayDay               Int?
  lastBirthdayAgeUpdateYear Int?
  role                      String   @default("child") @db.VarChar(64)
  relationshipToHousehold   String   @default("child") @db.VarChar(64)
  familyBranch              String   @default("primary") @db.VarChar(64)
  custodySchedule           String?  @db.VarChar(128)
  familyNotes               String?  @db.VarChar(255)
  avatar                    String   @default("🧒") @db.VarChar(32)
  color                     String   @default("#a78bfa") @db.VarChar(32)
  totalPoints               Int      @default(0)
  level                     Int      @default(1)
  createdAt                 DateTime @default(now())

  assignments      ChoreAssignment[]
  completions      TaskCompletion[]
  allowances       WeeklyAllowance[]
  skills           MemberSkill[]
  allowanceSetting AllowanceSettings?
  wishList         WishListItem[]
  houseProjects    HouseProject[]      @relation("ProjectAssignee")
  rewardTickets    RewardTicket[]
  devices          HouseholdDevice[]
  pairingCodes     DevicePairingCode[]
  household        Household           @relation(fields: [householdId], references: [id], onDelete: Cascade)
  familyTreeNodes  FamilyTreeNode[]
}

model FamilyTreeNode {
  id              Int      @id @default(autoincrement())
  householdId     Int
  kind            String   @default("external") @db.VarChar(32)
  familyMemberId  Int?
  parentAccountId Int?
  name            String   @db.VarChar(255)
  avatar          String   @default("👤") @db.VarChar(32)
  color           String   @default("#a78bfa") @db.VarChar(32)
  birthYear       Int?
  birthdayMonth   Int?
  birthdayDay     Int?
  notes           String?  @db.Text
  x               Int?
  y               Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  household        Household                @relation(fields: [householdId], references: [id], onDelete: Cascade)
  familyMember     FamilyMember?            @relation(fields: [familyMemberId], references: [id], onDelete: SetNull)
  parentAccount    ParentAccount?           @relation(fields: [parentAccountId], references: [id], onDelete: SetNull)
  outgoingRelations FamilyTreeRelationship[] @relation("FamilyTreeRelationshipFrom")
  incomingRelations FamilyTreeRelationship[] @relation("FamilyTreeRelationshipTo")

  @@unique([householdId, familyMemberId])
  @@unique([householdId, parentAccountId])
  @@index([householdId, kind])
}

model FamilyTreeRelationship {
  id               Int      @id @default(autoincrement())
  householdId      Int
  fromNodeId       Int
  toNodeId         Int
  relationshipType String   @db.VarChar(64)
  label            String?  @db.VarChar(128)
  notes            String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt

  household Household      @relation(fields: [householdId], references: [id], onDelete: Cascade)
  fromNode  FamilyTreeNode @relation("FamilyTreeRelationshipFrom", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNode    FamilyTreeNode @relation("FamilyTreeRelationshipTo", fields: [toNodeId], references: [id], onDelete: Cascade)

  @@unique([fromNodeId, toNodeId, relationshipType])
  @@index([householdId, relationshipType])
}

model Chore {
  id            Int     @id @default(autoincrement())
  householdId   Int
  name          String  @db.VarChar(255)
  description   String? @db.Text
  icon          String  @default("✅") @db.VarChar(32)
  color         String  @default("#e0e7ff") @db.VarChar(32)
  ageMin        Int     @default(3)
  ageMax        Int     @default(18)
  pointsValue   Int     @default(10)
  category      String  @default("other") @db.VarChar(64)
  requiresPhoto Boolean @default(false)

  assignments  ChoreAssignment[]
  skillLinks   ChoreSkill[]
  instructions ChoreInstructions?
  household    Household          @relation(fields: [householdId], references: [id], onDelete: Cascade)
}

model ChoreAssignment {
  id          Int       @id @default(autoincrement())
  householdId Int
  memberId    Int
  choreId     Int
  frequency   String    @default("daily") @db.VarChar(64)
  dueDate     DateTime?
  dayOfWeek   Int?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  member      FamilyMember     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  chore       Chore            @relation(fields: [choreId], references: [id], onDelete: Cascade)
  completions TaskCompletion[]
  household   Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
}

model TaskCompletion {
  id               Int      @id @default(autoincrement())
  householdId      Int
  assignmentId     Int
  memberId         Int
  completedAt      DateTime @default(now())
  completionDate   DateTime @default(now())
  photoBeforePath  String?
  photoAfterPath   String?
  reactionEmoji    String?  @db.VarChar(32)
  pointsEarned     Int      @default(0)
  verifiedByParent Boolean  @default(false)
  weekStartDate    DateTime @default(now())

  assignment ChoreAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  member     FamilyMember    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  household  Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, completionDate])
}

model SkillCategory {
  id          Int    @id @default(autoincrement())
  householdId Int
  name        String @db.VarChar(255)
  icon        String @default("⭐") @db.VarChar(32)

  chores    ChoreSkill[]
  members   MemberSkill[]
  household Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
}

model ChoreSkill {
  choreId Int
  skillId Int

  chore Chore         @relation(fields: [choreId], references: [id], onDelete: Cascade)
  skill SkillCategory @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([choreId, skillId])
}

model MemberSkill {
  memberId Int
  skillId  Int
  xp       Int @default(0)
  level    Int @default(1)

  member FamilyMember  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  skill  SkillCategory @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([memberId, skillId])
}

model WeeklyAllowance {
  id           Int      @id @default(autoincrement())
  householdId  Int
  memberId     Int
  weekStart    DateTime
  pointsEarned Int      @default(0)
  amountEarned Float    @default(0)
  paidOut      Boolean  @default(false)

  member    FamilyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  household Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([memberId, weekStart])
}

model AllowanceSettings {
  id             Int   @id @default(autoincrement())
  householdId    Int
  memberId       Int   @unique
  weeklyBaseRate Float @default(0)
  pointsToDollar Float @default(0.10)

  member    FamilyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  household Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)
}

model ChoreInstructions {
  id          Int      @id @default(autoincrement())
  choreId     Int      @unique
  steps       String   @db.Text
  tips        String   @db.Text
  safetyNotes String   @db.Text
  aiGenerated Boolean  @default(true)
  updatedAt   DateTime @default(now()) @updatedAt

  chore Chore @relation(fields: [choreId], references: [id], onDelete: Cascade)
}

model WishListItem {
  id          Int      @id @default(autoincrement())
  householdId Int
  memberId    Int
  title       String   @db.VarChar(255)
  category    String   @default("other") @db.VarChar(64)
  emoji       String   @default("🎁") @db.VarChar(32)
  note        String?  @db.Text
  status      String   @default("pending") @db.VarChar(64)
  createdAt   DateTime @default(now())

  member    FamilyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  household Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)
}

model HouseProject {
  id          Int       @id @default(autoincrement())
  householdId Int
  title       String    @db.VarChar(255)
  description String?   @db.Text
  category    String    @default("other") @db.VarChar(64)
  emoji       String    @default("🔧") @db.VarChar(32)
  rewardTitle String    @db.VarChar(255)
  rewardEmoji String    @default("🎫") @db.VarChar(32)
  pointsBonus Int       @default(50)
  assignedTo  Int?
  status      String    @default("open") @db.VarChar(64)
  dueDate     DateTime?
  createdAt   DateTime  @default(now())

  assignee  FamilyMember?  @relation("ProjectAssignee", fields: [assignedTo], references: [id], onDelete: SetNull)
  tickets   RewardTicket[]
  household Household      @relation(fields: [householdId], references: [id], onDelete: Cascade)
}

model RewardTicket {
  id          Int       @id @default(autoincrement())
  householdId Int
  projectId   Int
  memberId    Int
  rewardTitle String    @db.VarChar(255)
  rewardEmoji String    @default("🎫") @db.VarChar(32)
  status      String    @default("pending") @db.VarChar(64)
  earnedAt    DateTime  @default(now())
  redeemedAt  DateTime?

  project   HouseProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  member    FamilyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  household Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)
}

model GroceryList {
  id               Int       @id @default(autoincrement())
  householdId      Int
  title            String    @db.VarChar(255)
  status           String    @default("active") @db.VarChar(64)
  sourceTemplateId Int?
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt

  household      Household         @relation(fields: [householdId], references: [id], onDelete: Cascade)
  sourceTemplate GroceryTemplate?  @relation(fields: [sourceTemplateId], references: [id], onDelete: SetNull)
  items          GroceryListItem[]
}

model GroceryListItem {
  id        Int      @id @default(autoincrement())
  listId    Int
  name      String   @db.VarChar(255)
  category  String   @default("other") @db.VarChar(64)
  quantity  String?  @db.VarChar(64)
  unit      String?  @db.VarChar(64)
  note      String?  @db.Text
  checked   Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  list GroceryList @relation(fields: [listId], references: [id], onDelete: Cascade)
}

model GroceryTemplate {
  id          Int       @id @default(autoincrement())
  householdId Int
  title       String    @db.VarChar(255)
  cadence     String    @default("weekly") @db.VarChar(64)
  isActive    Boolean   @default(true)
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  household Household             @relation(fields: [householdId], references: [id], onDelete: Cascade)
  lists     GroceryList[]
  items     GroceryTemplateItem[]
}

model GroceryTemplateItem {
  id         Int      @id @default(autoincrement())
  templateId Int
  name       String   @db.VarChar(255)
  category   String   @default("other") @db.VarChar(64)
  quantity   String?  @db.VarChar(64)
  unit       String?  @db.VarChar(64)
  note       String?  @db.Text
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  template GroceryTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

model CommunityGroup {
  id              Int      @id @default(autoincrement())
  creatorParentId Int
  name            String   @db.VarChar(255)
  groupType       String   @default("other") @db.VarChar(64)
  description     String?  @db.Text
  location        String?  @db.VarChar(255)
  visibility      String   @default("private") @db.VarChar(64)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  creator ParentAccount     @relation("CommunityCreator", fields: [creatorParentId], references: [id], onDelete: Cascade)
  members CommunityMember[]
  events  CommunityEvent[]
}

model CommunityMember {
  id       Int      @id @default(autoincrement())
  groupId  Int
  parentId Int
  role     String   @default("member") @db.VarChar(64)
  status   String   @default("active") @db.VarChar(64)
  joinedAt DateTime @default(now())

  group  CommunityGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  parent ParentAccount  @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@unique([groupId, parentId])
}

model CommunityEvent {
  id                Int       @id @default(autoincrement())
  groupId           Int
  createdByParentId Int?
  title             String    @db.VarChar(255)
  eventType         String    @default("other") @db.VarChar(64)
  date              DateTime
  endDate           DateTime?
  allDay            Boolean   @default(false)
  location          String?   @db.VarChar(255)
  imageUrl          String?   @db.VarChar(512)
  visibility        String    @default("private") @db.VarChar(64)
  notes             String?   @db.Text
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now()) @updatedAt

  group     CommunityGroup       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy ParentAccount?       @relation("CommunityEventCreator", fields: [createdByParentId], references: [id], onDelete: SetNull)
  rsvps     CommunityRsvp[]
  items     CommunityEventItem[]
}

model CommunityRsvp {
  id        Int      @id @default(autoincrement())
  eventId   Int
  parentId  Int
  status    String   @default("going") @db.VarChar(64)
  guests    Int      @default(0)
  note      String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  event  CommunityEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  parent ParentAccount  @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@unique([eventId, parentId])
}

model CommunityEventItem {
  id                 Int      @id @default(autoincrement())
  eventId            Int
  title              String   @db.VarChar(255)
  quantity           String?  @db.VarChar(64)
  note               String?  @db.Text
  assignedToParentId Int?
  claimedByParentId  Int?
  claimNote          String?  @db.Text
  status             String   @default("open") @db.VarChar(64)
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt

  event      CommunityEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  assignedTo ParentAccount? @relation("CommunityItemAssignee", fields: [assignedToParentId], references: [id], onDelete: SetNull)
  claimedBy  ParentAccount? @relation("CommunityItemClaimer", fields: [claimedByParentId], references: [id], onDelete: SetNull)
}

model FamilyEvent {
  id                      Int       @id @default(autoincrement())
  householdId             Int
  title                   String    @db.VarChar(255)
  eventType               String    @default("other") @db.VarChar(64)
  date                    DateTime
  endDate                 DateTime?
  allDay                  Boolean   @default(true)
  recurring               String    @default("none") @db.VarChar(64)
  recurringEndDate        DateTime?
  recurringCount          Int?
  location                String?   @db.VarChar(255)
  meetingUrl              String?   @db.VarChar(512)
  rsvpUrl                 String?   @db.VarChar(512)
  flyerUrl                String?   @db.VarChar(512)
  registrationUrl         String?   @db.VarChar(512)
  registrationNotes       String?   @db.Text
  resources               String?   @db.Text
  notes                   String?   @db.Text
  color                   String    @default("#fbbf24") @db.VarChar(32)
  icon                    String    @default("📅") @db.VarChar(32)
  googleCalendarEventId   String?   @db.VarChar(255)
  googleCalendarSyncedAt  DateTime?
  googleCalendarSyncError String?   @db.Text
  createdAt               DateTime  @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
}

model HouseholdDevice {
  id          Int       @id @default(autoincrement())
  householdId Int
  memberId    Int?
  name        String    @db.VarChar(255)
  mode        String    @default("household") @db.VarChar(32)
  tokenHash   String    @unique @db.VarChar(255)
  lastSeenAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  household Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  member    FamilyMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)
}

model DevicePairingCode {
  id          Int       @id @default(autoincrement())
  householdId Int
  memberId    Int?
  codeHash    String    @unique @db.VarChar(255)
  deviceName  String    @db.VarChar(255)
  mode        String    @default("household") @db.VarChar(32)
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  household Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  member    FamilyMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)
}
