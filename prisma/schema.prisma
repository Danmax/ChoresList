generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x", "linux-musl-openssl-3.0.x", "linux-musl"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model ParentAccount {
  id                   String   @id @default(uuid()) @db.Char(36)
  householdId          String   @db.Char(36)
  email                String   @unique @db.VarChar(255)
  passwordHash         String   @db.VarChar(255)
  passwordSalt         String   @db.VarChar(255)
  pinHash              String?  @db.VarChar(255)
  pinSalt              String?  @db.VarChar(255)
  accountRole          String   @default("owner") @db.VarChar(32)
  displayName          String?  @db.VarChar(255)
  parentType           String   @default("parent") @db.VarChar(64)
  relationshipLabel    String?  @db.VarChar(128)
  childAccessMode      String   @default("all") @db.VarChar(32)
  childAccessMemberIds Json?
  emailVerified        Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @default(now()) @updatedAt

  household                  Household                  @relation(fields: [householdId], references: [id], onDelete: Cascade)
  confirmationTokens         EmailConfirmationToken[]
  passwordResetTokens        PasswordResetToken[]
  pinResetTokens             PinResetToken[]
  createdCommunities         CommunityGroup[]           @relation("CommunityCreator")
  communityMemberships       CommunityMember[]
  createdCommunityEvents     CommunityEvent[]           @relation("CommunityEventCreator")
  communityRsvps             CommunityRsvp[]
  assignedCommunityItems     CommunityEventItem[]       @relation("CommunityItemAssignee")
  claimedCommunityItems      CommunityEventItem[]       @relation("CommunityItemClaimer")
  communityMessages          CommunityEventMessage[]
  communityParticipants      CommunityParticipant[]
  checkedCommunityAttendance CommunityEventAttendance[] @relation("CommunityAttendanceChecker")
  reviewedSkillTests         SkillTestAttempt[]         @relation("SkillTestReviewer")
  awardedSkillXpEvents       SkillXpEvent[]             @relation("SkillXpAwarder")
  awardedBadges              MemberBadge[]              @relation("BadgeAwarder")
  activatedPlugins           HouseholdPlugin[]          @relation("PluginActivator")
  familyTreeNodes            FamilyTreeNode[]
  createdRecipes             Recipe[]                   @relation("RecipeCreator")
  familyMemberProfile        FamilyMember?              @relation("ParentFamilyMember")
  wellbeingCheckIns         WellbeingCheckIn[]          @relation("WellbeingRecorder")
}

model Household {
  id                            String   @id @default(uuid()) @db.Char(36)
  name                          String   @db.VarChar(255)
  timeZone                      String   @default("America/New_York") @db.VarChar(64)
  googleCalendarEnabled         Boolean  @default(false)
  googleCalendarId              String?  @db.VarChar(255)
  googleCalendarSyncAssignments Boolean  @default(false)
  googleCalendarSyncEvents      Boolean  @default(true)
  emailNotificationsEnabled     Boolean  @default(true)
  emailDailySummary             Boolean  @default(false)
  emailWeeklyReport             Boolean  @default(true)
  privacyShowKidPoints          Boolean  @default(true)
  privacyAllowKidWishlist       Boolean  @default(true)
  privacyStoreCompletionPhotos  Boolean  @default(true)
  privacyAnalyticsOptIn         Boolean  @default(false)
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @default(now()) @updatedAt

  parents                  ParentAccount[]
  members                  FamilyMember[]
  chores                   Chore[]
  assignments              ChoreAssignment[]
  completions              TaskCompletion[]
  skillCategories          SkillCategory[]
  allowances               WeeklyAllowance[]
  allowanceSettings        AllowanceSettings[]
  wishList                 WishListItem[]
  houseProjects            HouseProject[]
  rewardTickets            RewardTicket[]
  events                   FamilyEvent[]
  devices                  HouseholdDevice[]
  pairingCodes             DevicePairingCode[]
  groceryLists             GroceryList[]
  groceryTemplates         GroceryTemplate[]
  googleCalendarConnection GoogleCalendarConnection?
  plugins                  HouseholdPlugin[]
  familyTreeNodes          FamilyTreeNode[]
  familyTreeRelationships  FamilyTreeRelationship[]
  educationMaterialSets    EducationMaterialSet[]
  educationAssignments     EducationAssignment[]
  educationAttempts        EducationAttempt[]
  educationProjects        EducationProject[]
  recipes                  Recipe[]
  skillXpEvents            SkillXpEvent[]
  meritBadges              MeritBadge[]
  memberBadges             MemberBadge[]
  wellbeingCheckIns        WellbeingCheckIn[]
}

model HouseholdPlugin {
  id                  String    @id @default(uuid()) @db.Char(36)
  householdId         String    @db.Char(36)
  pluginKey           String    @db.VarChar(64)
  status              String    @default("inactive") @db.VarChar(32)
  settings            Json?
  activatedAt         DateTime?
  activatedByParentId String?   @db.Char(36)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @default(now()) @updatedAt

  household         Household      @relation(fields: [householdId], references: [id], onDelete: Cascade)
  activatedByParent ParentAccount? @relation("PluginActivator", fields: [activatedByParentId], references: [id], onDelete: SetNull)

  @@unique([householdId, pluginKey])
  @@index([pluginKey])
}

model GoogleCalendarConnection {
  id                 String    @id @default(uuid()) @db.Char(36)
  householdId        String    @unique @db.Char(36)
  googleAccountEmail String?   @db.VarChar(255)
  calendarId         String    @default("primary") @db.VarChar(255)
  refreshToken       String    @db.Text
  accessToken        String?   @db.Text
  expiresAt          DateTime?
  syncStatus         String?   @db.VarChar(64)
  lastSyncAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @default(now()) @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
}

model EmailConfirmationToken {
  id        String    @id @default(uuid()) @db.Char(36)
  parentId  String    @db.Char(36)
  tokenHash String    @unique @db.VarChar(255)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  parent ParentAccount @relation(fields: [parentId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Char(36)
  parentId  String    @db.Char(36)
  tokenHash String    @unique @db.VarChar(255)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  parent ParentAccount @relation(fields: [parentId], references: [id], onDelete: Cascade)
}

model PinResetToken {
  id        String    @id @default(uuid()) @db.Char(36)
  parentId  String    @db.Char(36)
  tokenHash String    @unique @db.VarChar(255)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  parent ParentAccount @relation(fields: [parentId], references: [id], onDelete: Cascade)
}

model FamilyMember {
  id                        String   @id @default(uuid()) @db.Char(36)
  householdId               String   @db.Char(36)
  parentAccountId           String?  @unique @db.Char(36)
  name                      String   @db.VarChar(255)
  age                       Int
  birthdayMonth             Int?
  birthdayDay               Int?
  lastBirthdayAgeUpdateYear Int?
  role                      String   @default("child") @db.VarChar(64)
  relationshipToHousehold   String   @default("child") @db.VarChar(64)
  familyBranch              String   @default("primary") @db.VarChar(64)
  custodySchedule           String?  @db.VarChar(128)
  familyNotes               String?  @db.VarChar(255)
  avatar                    String   @default("🧒") @db.VarChar(32)
  color                     String   @default("#a78bfa") @db.VarChar(32)
  totalPoints               Int      @default(0)
  level                     Int      @default(1)
  createdAt                 DateTime @default(now())

  assignments           ChoreAssignment[]
  completions           TaskCompletion[]
  allowances            WeeklyAllowance[]
  skills                MemberSkill[]
  skillXpEvents         SkillXpEvent[]
  wellbeingCheckIns     WellbeingCheckIn[]
  badges                MemberBadge[]
  communityParticipants CommunityParticipant[]
  skillTestAttempts     SkillTestAttempt[]
  allowanceSetting      AllowanceSettings?
  wishList              WishListItem[]
  houseProjects         HouseProject[]         @relation("ProjectAssignee")
  rewardTickets         RewardTicket[]
  devices               HouseholdDevice[]
  pairingCodes          DevicePairingCode[]
  household             Household              @relation(fields: [householdId], references: [id], onDelete: Cascade)
  parentAccount         ParentAccount?         @relation("ParentFamilyMember", fields: [parentAccountId], references: [id], onDelete: SetNull)
  familyTreeNodes       FamilyTreeNode[]
  educationAssignments  EducationAssignment[]
  educationAttempts     EducationAttempt[]
  educationProjects     EducationProject[]

  @@index([householdId, role])
}

model WellbeingCheckIn {
  id                 String   @id @default(uuid()) @db.Char(36)
  householdId        String   @db.Char(36)
  memberId           String   @db.Char(36)
  recordedByParentId String   @db.Char(36)
  mood               String   @db.VarChar(32)
  note               String?  @db.Text
  supportRequested   Boolean  @default(false)
  createdAt          DateTime @default(now())

  household Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  member    FamilyMember  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  recordedBy ParentAccount @relation("WellbeingRecorder", fields: [recordedByParentId], references: [id], onDelete: Cascade)

  @@index([householdId, createdAt])
  @@index([memberId, createdAt])
}

model EducationMaterialSet {
  id           String   @id @default(uuid()) @db.Char(36)
  householdId  String   @db.Char(36)
  skillId      String?  @db.Char(36)
  title        String   @db.VarChar(255)
  subject      String   @default("vocabulary") @db.VarChar(64)
  mode         String   @default("drill") @db.VarChar(64)
  description  String?  @db.Text
  passingScore Int      @default(85)
  pointsReward Int      @default(10)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  household   Household             @relation(fields: [householdId], references: [id], onDelete: Cascade)
  skill       SkillCategory?        @relation(fields: [skillId], references: [id], onDelete: SetNull)
  materials   EducationMaterial[]
  assignments EducationAssignment[]

  @@index([householdId, subject])
  @@index([skillId])
}

model EducationMaterial {
  id          String   @id @default(uuid()) @db.Char(36)
  setId       String   @db.Char(36)
  prompt      String   @db.Text
  answer      String   @db.Text
  choices     Json?
  explanation String?  @db.Text
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  set EducationMaterialSet @relation(fields: [setId], references: [id], onDelete: Cascade)
}

model EducationAssignment {
  id           String    @id @default(uuid()) @db.Char(36)
  householdId  String    @db.Char(36)
  memberId     String    @db.Char(36)
  setId        String    @db.Char(36)
  title        String    @db.VarChar(255)
  dueDate      DateTime?
  status       String    @default("assigned") @db.VarChar(64)
  passingScore Int       @default(85)
  pointsReward Int       @default(10)
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt

  household Household            @relation(fields: [householdId], references: [id], onDelete: Cascade)
  member    FamilyMember         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  set       EducationMaterialSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  attempts  EducationAttempt[]

  @@index([householdId, memberId, status])
}

model EducationAttempt {
  id           String   @id @default(uuid()) @db.Char(36)
  householdId  String   @db.Char(36)
  assignmentId String   @db.Char(36)
  memberId     String   @db.Char(36)
  score        Int      @default(0)
  correctCount Int      @default(0)
  totalCount   Int      @default(0)
  passed       Boolean  @default(false)
  answers      Json?
  completedAt  DateTime @default(now())

  household  Household           @relation(fields: [householdId], references: [id], onDelete: Cascade)
  assignment EducationAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  member     FamilyMember        @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([householdId, memberId, completedAt])
}

model EducationProject {
  id           String    @id @default(uuid()) @db.Char(36)
  householdId  String    @db.Char(36)
  memberId     String?   @db.Char(36)
  skillId      String?   @db.Char(36)
  title        String    @db.VarChar(255)
  subject      String    @default("project") @db.VarChar(64)
  description  String?   @db.Text
  rubric       String?   @db.Text
  status       String    @default("open") @db.VarChar(64)
  dueDate      DateTime?
  pointsReward Int       @default(25)
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt

  household Household      @relation(fields: [householdId], references: [id], onDelete: Cascade)
  member    FamilyMember?  @relation(fields: [memberId], references: [id], onDelete: SetNull)
  skill     SkillCategory? @relation(fields: [skillId], references: [id], onDelete: SetNull)

  @@index([householdId, status])
  @@index([skillId])
}

model FamilyTreeNode {
  id              String   @id @default(uuid()) @db.Char(36)
  householdId     String   @db.Char(36)
  kind            String   @default("external") @db.VarChar(32)
  familyMemberId  String?  @db.Char(36)
  parentAccountId String?  @db.Char(36)
  name            String   @db.VarChar(255)
  avatar          String   @default("👤") @db.VarChar(32)
  color           String   @default("#a78bfa") @db.VarChar(32)
  birthYear       Int?
  birthdayMonth   Int?
  birthdayDay     Int?
  notes           String?  @db.Text
  x               Int?
  y               Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  household         Household                @relation(fields: [householdId], references: [id], onDelete: Cascade)
  familyMember      FamilyMember?            @relation(fields: [familyMemberId], references: [id], onDelete: SetNull)
  parentAccount     ParentAccount?           @relation(fields: [parentAccountId], references: [id], onDelete: SetNull)
  outgoingRelations FamilyTreeRelationship[] @relation("FamilyTreeRelationshipFrom")
  incomingRelations FamilyTreeRelationship[] @relation("FamilyTreeRelationshipTo")

  @@unique([householdId, familyMemberId])
  @@unique([householdId, parentAccountId])
  @@index([householdId, kind])
}

model FamilyTreeRelationship {
  id               String   @id @default(uuid()) @db.Char(36)
  householdId      String   @db.Char(36)
  fromNodeId       String   @db.Char(36)
  toNodeId         String   @db.Char(36)
  relationshipType String   @db.VarChar(64)
  label            String?  @db.VarChar(128)
  notes            String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt

  household Household      @relation(fields: [householdId], references: [id], onDelete: Cascade)
  fromNode  FamilyTreeNode @relation("FamilyTreeRelationshipFrom", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNode    FamilyTreeNode @relation("FamilyTreeRelationshipTo", fields: [toNodeId], references: [id], onDelete: Cascade)

  @@unique([fromNodeId, toNodeId, relationshipType])
  @@index([householdId, relationshipType])
}

model Chore {
  id            String  @id @default(uuid()) @db.Char(36)
  householdId   String  @db.Char(36)
  name          String  @db.VarChar(255)
  description   String? @db.Text
  icon          String  @default("✅") @db.VarChar(32)
  color         String  @default("#e0e7ff") @db.VarChar(32)
  ageMin        Int     @default(3)
  ageMax        Int     @default(18)
  pointsValue   Int     @default(10)
  category      String  @default("other") @db.VarChar(64)
  requiresPhoto Boolean @default(false)

  assignments  ChoreAssignment[]
  skillLinks   ChoreSkill[]
  instructions ChoreInstructions?
  household    Household          @relation(fields: [householdId], references: [id], onDelete: Cascade)
}

model ChoreAssignment {
  id          String    @id @default(uuid()) @db.Char(36)
  householdId String    @db.Char(36)
  memberId    String    @db.Char(36)
  choreId     String    @db.Char(36)
  frequency   String    @default("daily") @db.VarChar(64)
  dueDate     DateTime?
  dayOfWeek   Int?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  member      FamilyMember     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  chore       Chore            @relation(fields: [choreId], references: [id], onDelete: Cascade)
  completions TaskCompletion[]
  household   Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
}

model TaskCompletion {
  id               String   @id @default(uuid()) @db.Char(36)
  householdId      String   @db.Char(36)
  assignmentId     String   @db.Char(36)
  memberId         String   @db.Char(36)
  completedAt      DateTime @default(now())
  completionDate   DateTime @default(now())
  photoBeforePath  String?
  photoAfterPath   String?
  reactionEmoji    String?  @db.VarChar(32)
  pointsEarned     Int      @default(0)
  verifiedByParent Boolean  @default(false)
  weekStartDate    DateTime @default(now())

  assignment ChoreAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  member     FamilyMember    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  household  Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, completionDate])
}

model SkillCategory {
  id          String @id @default(uuid()) @db.Char(36)
  householdId String @db.Char(36)
  name        String @db.VarChar(255)
  icon        String @default("⭐") @db.VarChar(32)

  chores            ChoreSkill[]
  members           MemberSkill[]
  xpEvents          SkillXpEvent[]
  meritBadges       MeritBadge[]
  classPlans        CommunityClassPlan[]
  skillTests        SkillTest[]
  educationSets     EducationMaterialSet[]
  educationProjects EducationProject[]
  household         Household              @relation(fields: [householdId], references: [id], onDelete: Cascade)
}

model ChoreSkill {
  choreId String @db.Char(36)
  skillId String @db.Char(36)

  chore Chore         @relation(fields: [choreId], references: [id], onDelete: Cascade)
  skill SkillCategory @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([choreId, skillId])
}

model MemberSkill {
  memberId String @db.Char(36)
  skillId  String @db.Char(36)
  xp       Int    @default(0)
  level    Int    @default(1)

  member FamilyMember  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  skill  SkillCategory @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([memberId, skillId])
}

model SkillXpEvent {
  id                String   @id @default(uuid()) @db.Char(36)
  householdId       String   @db.Char(36)
  memberId          String   @db.Char(36)
  skillId           String   @db.Char(36)
  sourceType        String   @db.VarChar(64)
  sourceId          String?  @db.Char(36)
  xp                Int
  note              String?  @db.Text
  awardedByParentId String?  @db.Char(36)
  createdAt         DateTime @default(now())

  household Household      @relation(fields: [householdId], references: [id], onDelete: Cascade)
  member    FamilyMember   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  skill     SkillCategory  @relation(fields: [skillId], references: [id], onDelete: Cascade)
  awardedBy ParentAccount? @relation("SkillXpAwarder", fields: [awardedByParentId], references: [id], onDelete: SetNull)

  @@unique([householdId, memberId, skillId, sourceType, sourceId], map: "skill_xp_event_source_uq")
  @@index([householdId, memberId, createdAt], map: "skill_xp_member_created_idx")
  @@index([skillId], map: "skill_xp_skill_idx")
}

model MeritBadge {
  id                      String   @id @default(uuid()) @db.Char(36)
  householdId             String?  @db.Char(36)
  communityGroupId        String?  @db.Char(36)
  skillId                 String?  @db.Char(36)
  title                   String   @db.VarChar(255)
  icon                    String   @default("🏅") @db.VarChar(32)
  description             String?  @db.Text
  requirements            Json?
  xpReward                Int      @default(25)
  requiresTest            Boolean  @default(true)
  requiresAttendance      Boolean  @default(false)
  requiresManagerApproval Boolean  @default(true)
  isActive                Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @default(now()) @updatedAt

  household  Household?           @relation(fields: [householdId], references: [id], onDelete: Cascade)
  group      CommunityGroup?      @relation(fields: [communityGroupId], references: [id], onDelete: Cascade)
  skill      SkillCategory?       @relation(fields: [skillId], references: [id], onDelete: SetNull)
  awards     MemberBadge[]
  classPlans CommunityClassPlan[]
  skillTests SkillTest[]

  @@index([householdId], map: "merit_badge_household_idx")
  @@index([communityGroupId], map: "merit_badge_group_idx")
  @@index([skillId], map: "merit_badge_skill_idx")
}

model MemberBadge {
  id                String   @id @default(uuid()) @db.Char(36)
  householdId       String   @db.Char(36)
  memberId          String   @db.Char(36)
  badgeId           String   @db.Char(36)
  communityGroupId  String?  @db.Char(36)
  awardedByParentId String?  @db.Char(36)
  evidence          Json?
  note              String?  @db.Text
  awardedAt         DateTime @default(now())

  household Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)
  member    FamilyMember    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  badge     MeritBadge      @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  group     CommunityGroup? @relation(fields: [communityGroupId], references: [id], onDelete: SetNull)
  awardedBy ParentAccount?  @relation("BadgeAwarder", fields: [awardedByParentId], references: [id], onDelete: SetNull)

  @@unique([memberId, badgeId, communityGroupId], map: "member_badge_award_uq")
  @@index([householdId, memberId], map: "member_badge_member_idx")
  @@index([badgeId], map: "member_badge_badge_idx")
}

model WeeklyAllowance {
  id           String   @id @default(uuid()) @db.Char(36)
  householdId  String   @db.Char(36)
  memberId     String   @db.Char(36)
  weekStart    DateTime
  pointsEarned Int      @default(0)
  amountEarned Float    @default(0)
  paidOut      Boolean  @default(false)

  member    FamilyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  household Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([memberId, weekStart])
}

model AllowanceSettings {
  id             String @id @default(uuid()) @db.Char(36)
  householdId    String @db.Char(36)
  memberId       String @unique @db.Char(36)
  weeklyBaseRate Float  @default(0)
  pointsToDollar Float  @default(0.10)

  member    FamilyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  household Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)
}

model ChoreInstructions {
  id          String   @id @default(uuid()) @db.Char(36)
  choreId     String   @unique @db.Char(36)
  steps       String   @db.Text
  tips        String   @db.Text
  safetyNotes String   @db.Text
  aiGenerated Boolean  @default(true)
  updatedAt   DateTime @default(now()) @updatedAt

  chore Chore @relation(fields: [choreId], references: [id], onDelete: Cascade)
}

model WishListItem {
  id          String   @id @default(uuid()) @db.Char(36)
  householdId String   @db.Char(36)
  memberId    String   @db.Char(36)
  title       String   @db.VarChar(255)
  category    String   @default("other") @db.VarChar(64)
  emoji       String   @default("🎁") @db.VarChar(32)
  note        String?  @db.Text
  status      String   @default("pending") @db.VarChar(64)
  createdAt   DateTime @default(now())

  member    FamilyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  household Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)
}

model HouseProject {
  id          String    @id @default(uuid()) @db.Char(36)
  householdId String    @db.Char(36)
  title       String    @db.VarChar(255)
  description String?   @db.Text
  category    String    @default("other") @db.VarChar(64)
  emoji       String    @default("🔧") @db.VarChar(32)
  rewardTitle String    @db.VarChar(255)
  rewardEmoji String    @default("🎫") @db.VarChar(32)
  pointsBonus Int       @default(50)
  assignedTo  String?   @db.Char(36)
  status      String    @default("open") @db.VarChar(64)
  dueDate     DateTime?
  createdAt   DateTime  @default(now())

  assignee  FamilyMember?  @relation("ProjectAssignee", fields: [assignedTo], references: [id], onDelete: SetNull)
  tickets   RewardTicket[]
  household Household      @relation(fields: [householdId], references: [id], onDelete: Cascade)
}

model RewardTicket {
  id          String    @id @default(uuid()) @db.Char(36)
  householdId String    @db.Char(36)
  projectId   String    @db.Char(36)
  memberId    String    @db.Char(36)
  rewardTitle String    @db.VarChar(255)
  rewardEmoji String    @default("🎫") @db.VarChar(32)
  status      String    @default("pending") @db.VarChar(64)
  earnedAt    DateTime  @default(now())
  redeemedAt  DateTime?

  project   HouseProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  member    FamilyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  household Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)
}

model GroceryList {
  id               String    @id @default(uuid()) @db.Char(36)
  householdId      String    @db.Char(36)
  title            String    @db.VarChar(255)
  status           String    @default("active") @db.VarChar(64)
  sourceTemplateId String?   @db.Char(36)
  completedAt      DateTime?
  completionNote   String?   @db.Text
  receiptPath      String?   @db.VarChar(512)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt

  household      Household         @relation(fields: [householdId], references: [id], onDelete: Cascade)
  sourceTemplate GroceryTemplate?  @relation(fields: [sourceTemplateId], references: [id], onDelete: SetNull)
  items          GroceryListItem[]
}

model GroceryListItem {
  id        String   @id @default(uuid()) @db.Char(36)
  listId    String   @db.Char(36)
  name      String   @db.VarChar(255)
  category  String   @default("other") @db.VarChar(64)
  quantity  String?  @db.VarChar(64)
  unit      String?  @db.VarChar(64)
  note      String?  @db.Text
  checked   Boolean  @default(false)
  onHand    Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  list GroceryList @relation(fields: [listId], references: [id], onDelete: Cascade)
}

model GroceryTemplate {
  id          String    @id @default(uuid()) @db.Char(36)
  householdId String    @db.Char(36)
  title       String    @db.VarChar(255)
  cadence     String    @default("weekly") @db.VarChar(64)
  isActive    Boolean   @default(true)
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  household Household             @relation(fields: [householdId], references: [id], onDelete: Cascade)
  lists     GroceryList[]
  items     GroceryTemplateItem[]
}

model GroceryTemplateItem {
  id         String   @id @default(uuid()) @db.Char(36)
  templateId String   @db.Char(36)
  name       String   @db.VarChar(255)
  category   String   @default("other") @db.VarChar(64)
  quantity   String?  @db.VarChar(64)
  unit       String?  @db.VarChar(64)
  note       String?  @db.Text
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  template GroceryTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

model Recipe {
  id                String   @id @default(uuid()) @db.Char(36)
  householdId       String   @db.Char(36)
  createdByParentId String?  @db.Char(36)
  title             String   @db.VarChar(255)
  description       String?  @db.Text
  servings          Int      @default(4)
  prepMinutes       Int?
  cookMinutes       Int?
  photoUrl          String?  @db.VarChar(512)
  instructions      String?  @db.Text
  visibility        String   @default("private") @db.VarChar(64)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt

  household   Household          @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy   ParentAccount?     @relation("RecipeCreator", fields: [createdByParentId], references: [id], onDelete: SetNull)
  ingredients RecipeIngredient[]

  @@index([householdId, visibility])
  @@index([visibility, createdAt])
}

model RecipeIngredient {
  id        String   @id @default(uuid()) @db.Char(36)
  recipeId  String   @db.Char(36)
  name      String   @db.VarChar(255)
  quantity  String?  @db.VarChar(64)
  unit      String?  @db.VarChar(64)
  category  String   @default("pantry") @db.VarChar(64)
  note      String?  @db.Text
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
}

model CommunityGroup {
  id              String   @id @default(uuid()) @db.Char(36)
  creatorParentId String   @db.Char(36)
  name            String   @db.VarChar(255)
  groupType       String   @default("other") @db.VarChar(64)
  description     String?  @db.Text
  location        String?  @db.VarChar(255)
  visibility      String   @default("private") @db.VarChar(64)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  creator      ParentAccount          @relation("CommunityCreator", fields: [creatorParentId], references: [id], onDelete: Cascade)
  members      CommunityMember[]
  participants CommunityParticipant[]
  events       CommunityEvent[]
  meritBadges  MeritBadge[]
  memberBadges MemberBadge[]
  skillTests   SkillTest[]
}

model CommunityMember {
  id       String   @id @default(uuid()) @db.Char(36)
  groupId  String   @db.Char(36)
  parentId String   @db.Char(36)
  role     String   @default("member") @db.VarChar(64)
  status   String   @default("active") @db.VarChar(64)
  emailNotificationsEnabled Boolean @default(true)
  emailItemAssignments Boolean @default(true)
  emailEventReminders Boolean @default(true)
  emailRegistrationUpdates Boolean @default(true)
  emailManagerWeeklySummary Boolean @default(true)
  joinedAt DateTime @default(now())

  group  CommunityGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  parent ParentAccount  @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@unique([groupId, parentId])
}

model EmailNotification {
  id                String    @id @default(uuid()) @db.Char(36)
  type              String    @db.VarChar(64)
  recipientParentId String?   @db.Char(36)
  recipientEmail    String    @db.VarChar(255)
  groupId           String?   @db.Char(36)
  eventId           String?   @db.Char(36)
  dedupeKey         String    @unique @db.VarChar(255)
  status            String    @default("pending") @db.VarChar(32)
  scheduledFor      DateTime
  payload           Json
  attempts          Int       @default(0)
  lastError         String?   @db.Text
  lockedAt          DateTime?
  sentAt            DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now()) @updatedAt

  @@index([status, scheduledFor])
  @@index([eventId, recipientParentId])
  @@index([groupId, type])
}

model CommunityEvent {
  id                String    @id @default(uuid()) @db.Char(36)
  groupId           String    @db.Char(36)
  createdByParentId String?   @db.Char(36)
  title             String    @db.VarChar(255)
  eventType         String    @default("other") @db.VarChar(64)
  date              DateTime
  endDate           DateTime?
  allDay            Boolean   @default(false)
  recurring         String    @default("none") @db.VarChar(64)
  recurringEndDate  DateTime?
  recurringCount    Int?
  seriesId          String?   @db.Char(36)
  sessionNumber     Int?
  location          String?   @db.VarChar(255)
  meetingUrl        String?   @db.VarChar(1024)
  registrationUrl   String?   @db.VarChar(1024)
  timeZone          String    @default("UTC") @db.VarChar(64)
  imageUrl          String?   @db.VarChar(512)
  visibility        String    @default("private") @db.VarChar(64)
  notes             String?   @db.Text
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now()) @updatedAt

  group      CommunityGroup             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy  ParentAccount?             @relation("CommunityEventCreator", fields: [createdByParentId], references: [id], onDelete: SetNull)
  rsvps      CommunityRsvp[]
  items      CommunityEventItem[]
  messages   CommunityEventMessage[]
  classPlan  CommunityClassPlan?
  attendance CommunityEventAttendance[]
  skillTests SkillTest[]

  @@index([seriesId, sessionNumber], map: "community_event_series_idx")
  @@index([recurring, date], map: "community_event_recurring_idx")
}

model CommunityParticipant {
  id          String   @id @default(uuid()) @db.Char(36)
  groupId     String   @db.Char(36)
  parentId    String   @db.Char(36)
  memberId    String   @db.Char(36)
  displayName String?  @db.VarChar(255)
  status      String   @default("active") @db.VarChar(64)
  joinedAt    DateTime @default(now())

  group        CommunityGroup             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  parent       ParentAccount              @relation(fields: [parentId], references: [id], onDelete: Cascade)
  member       FamilyMember               @relation(fields: [memberId], references: [id], onDelete: Cascade)
  attendance   CommunityEventAttendance[]
  testAttempts SkillTestAttempt[]

  @@unique([groupId, parentId, memberId], map: "community_participant_uq")
  @@index([groupId, status], map: "community_participant_group_idx")
  @@index([memberId], map: "community_participant_member_idx")
}

model CommunityClassPlan {
  id               String   @id @default(uuid()) @db.Char(36)
  eventId          String   @unique @db.Char(36)
  skillId          String?  @db.Char(36)
  badgeId          String?  @db.Char(36)
  lessonTitle      String   @db.VarChar(255)
  objectives       String?  @db.Text
  materials        String?  @db.Text
  agenda           String?  @db.Text
  homework         String?  @db.Text
  testInstructions String?  @db.Text
  attendanceXp     Int      @default(5)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt

  event CommunityEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  skill SkillCategory? @relation(fields: [skillId], references: [id], onDelete: SetNull)
  badge MeritBadge?    @relation(fields: [badgeId], references: [id], onDelete: SetNull)

  @@index([skillId], map: "community_class_plan_skill_idx")
  @@index([badgeId], map: "community_class_plan_badge_idx")
}

model CommunityEventAttendance {
  id                  String    @id @default(uuid()) @db.Char(36)
  eventId             String    @db.Char(36)
  participantId       String    @db.Char(36)
  status              String    @default("present") @db.VarChar(64)
  checkedInAt         DateTime?
  checkedInByParentId String?   @db.Char(36)
  notes               String?   @db.Text
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @default(now()) @updatedAt

  event       CommunityEvent       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  participant CommunityParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  checkedInBy ParentAccount?       @relation("CommunityAttendanceChecker", fields: [checkedInByParentId], references: [id], onDelete: SetNull)

  @@unique([eventId, participantId], map: "community_attendance_uq")
  @@index([participantId], map: "community_attendance_participant_idx")
}

model SkillTest {
  id               String   @id @default(uuid()) @db.Char(36)
  communityGroupId String?  @db.Char(36)
  eventId          String?  @db.Char(36)
  badgeId          String?  @db.Char(36)
  skillId          String?  @db.Char(36)
  title            String   @db.VarChar(255)
  instructions     String?  @db.Text
  passingScore     Int      @default(85)
  xpReward         Int      @default(25)
  status           String   @default("active") @db.VarChar(64)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt

  group    CommunityGroup?    @relation(fields: [communityGroupId], references: [id], onDelete: Cascade)
  event    CommunityEvent?    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  badge    MeritBadge?        @relation(fields: [badgeId], references: [id], onDelete: SetNull)
  skill    SkillCategory?     @relation(fields: [skillId], references: [id], onDelete: SetNull)
  attempts SkillTestAttempt[]

  @@index([communityGroupId], map: "skill_test_group_idx")
  @@index([eventId], map: "skill_test_event_idx")
  @@index([badgeId], map: "skill_test_badge_idx")
  @@index([skillId], map: "skill_test_skill_idx")
}

model SkillTestAttempt {
  id                 String    @id @default(uuid()) @db.Char(36)
  testId             String    @db.Char(36)
  participantId      String    @db.Char(36)
  memberId           String    @db.Char(36)
  score              Int       @default(0)
  passed             Boolean   @default(false)
  evidence           Json?
  notes              String?   @db.Text
  reviewedByParentId String?   @db.Char(36)
  reviewedAt         DateTime?
  createdAt          DateTime  @default(now())

  test        SkillTest            @relation(fields: [testId], references: [id], onDelete: Cascade)
  participant CommunityParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  member      FamilyMember         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  reviewedBy  ParentAccount?       @relation("SkillTestReviewer", fields: [reviewedByParentId], references: [id], onDelete: SetNull)

  @@index([testId, participantId], map: "skill_test_attempt_test_idx")
  @@index([memberId], map: "skill_test_attempt_member_idx")
}

model CommunityRsvp {
  id        String   @id @default(uuid()) @db.Char(36)
  eventId   String   @db.Char(36)
  parentId  String   @db.Char(36)
  status    String   @default("going") @db.VarChar(64)
  guests    Int      @default(0)
  note      String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  event  CommunityEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  parent ParentAccount  @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@unique([eventId, parentId])
}

model CommunityEventItem {
  id                 String   @id @default(uuid()) @db.Char(36)
  eventId            String   @db.Char(36)
  title              String   @db.VarChar(255)
  quantity           String?  @db.VarChar(64)
  note               String?  @db.Text
  assignedToParentId String?  @db.Char(36)
  claimedByParentId  String?  @db.Char(36)
  claimNote          String?  @db.Text
  status             String   @default("open") @db.VarChar(64)
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt

  event      CommunityEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  assignedTo ParentAccount? @relation("CommunityItemAssignee", fields: [assignedToParentId], references: [id], onDelete: SetNull)
  claimedBy  ParentAccount? @relation("CommunityItemClaimer", fields: [claimedByParentId], references: [id], onDelete: SetNull)
}

model CommunityEventMessage {
  id        String   @id @default(uuid()) @db.Char(36)
  eventId   String   @db.Char(36)
  parentId  String   @db.Char(36)
  body      String?  @db.Text
  emoji     String?  @db.VarChar(32)
  gifUrl    String?  @db.VarChar(512)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  event  CommunityEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  parent ParentAccount  @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@index([eventId, createdAt])
  @@index([parentId])
}

model FamilyEvent {
  id                      String    @id @default(uuid()) @db.Char(36)
  householdId             String    @db.Char(36)
  title                   String    @db.VarChar(255)
  eventType               String    @default("other") @db.VarChar(64)
  date                    DateTime
  endDate                 DateTime?
  allDay                  Boolean   @default(true)
  recurring               String    @default("none") @db.VarChar(64)
  recurringEndDate        DateTime?
  recurringCount          Int?
  location                String?   @db.VarChar(255)
  meetingUrl              String?   @db.VarChar(512)
  rsvpUrl                 String?   @db.VarChar(512)
  flyerUrl                String?   @db.VarChar(512)
  registrationUrl         String?   @db.VarChar(512)
  registrationNotes       String?   @db.Text
  resources               String?   @db.Text
  notes                   String?   @db.Text
  color                   String    @default("#fbbf24") @db.VarChar(32)
  icon                    String    @default("📅") @db.VarChar(32)
  googleCalendarEventId   String?   @db.VarChar(255)
  googleCalendarSyncedAt  DateTime?
  googleCalendarSyncError String?   @db.Text
  createdAt               DateTime  @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
}

model HouseholdDevice {
  id          String    @id @default(uuid()) @db.Char(36)
  householdId String    @db.Char(36)
  memberId    String?   @db.Char(36)
  name        String    @db.VarChar(255)
  mode        String    @default("household") @db.VarChar(32)
  tokenHash   String    @unique @db.VarChar(255)
  lastSeenAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  household Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  member    FamilyMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)
}

model DevicePairingCode {
  id          String    @id @default(uuid()) @db.Char(36)
  householdId String    @db.Char(36)
  memberId    String?   @db.Char(36)
  codeHash    String    @unique @db.VarChar(255)
  deviceName  String    @db.VarChar(255)
  mode        String    @default("household") @db.VarChar(32)
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  household Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  member    FamilyMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)
}
