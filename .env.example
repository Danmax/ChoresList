# Prisma / MySQL connection. Use a strong, unique password.
DATABASE_URL="mysql://user:password@host:3306/db_name"

# Required in production. Random secret used to sign session, device, and PIN-elevation cookies.
# Generate with:  openssl rand -base64 48
# Must be >= 32 chars. Placeholder values are rejected at runtime.
AUTH_SECRET=""

# Optional. Separate secret for the device pairing-code HMAC. Falls back to AUTH_SECRET when unset.
# Generate the same way:  openssl rand -base64 48
PAIRING_SECRET=""

# Required in production. Absolute base URL used to build confirmation, reset, and pair links in emails.
# Without this, those URLs would be derived from the request Host header (vulnerable to host injection).
PUBLIC_BASE_URL="https://chores.example.com"

# Google Calendar OAuth. The redirect URI must exactly match an authorized redirect URI
# in the Google Cloud OAuth client (for example, https://chores.example.com/api/google-calendar/callback).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="https://chores.example.com/api/google-calendar/callback"

# Seed parent login used by `npm run db:seed`. Change before running.
PARENT_EMAIL="parent@example.com"
PARENT_PASSWORD="ChangeMe123!"

# SMTP for account and community notification emails. Without these,
# the development confirmation link is returned, and queued notifications retry then fail.
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="parent@example.com"
SMTP_PASSWORD=""
SMTP_FROM="Chores List <parent@example.com>"

# OpenAI key for AI chore instructions.
CHATGPT_API_KEY=""

# Optional. Enables GIF search in event message boards. Pasted HTTPS GIF URLs still work without this.
GIPHY_API_KEY=""
# Persistent image storage. In production, use a directory outside the app release.
# Defaults to ../chores-uploads in production and ./storage/uploads in development.
UPLOADS_DIR=
